# Copia este archivo a `.env` y ajusta los valores.

# Cadena de conexión a PostgreSQL local.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASEDEDATOS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sui_validator

# Puerto donde escucha el backend.
PORT=8787

# Orígenes permitidos para CORS (separados por coma). El dev server de Vite
# corre en 5173 por defecto; agrega otros si los usas.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180
